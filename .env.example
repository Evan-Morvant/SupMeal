# ============================================================
# SUPMEAL — variables d'environnement (exemple)
# Copier vers `.env` et renseigner les valeurs. NE JAMAIS commiter `.env`.
# ============================================================

# --- PostgreSQL (service db) ---
POSTGRES_USER=supmeal
POSTGRES_PASSWORD=change_me
POSTGRES_DB=supmeal

# --- API (service api) ---
NODE_ENV=development
API_PORT=4000
# En conteneur, l'hôte de la BDD est le nom du service "db"
DATABASE_URL=postgres://supmeal:change_me@db:5432/supmeal
JWT_ACCESS_SECRET=change_me_access_secret
JWT_REFRESH_SECRET=change_me_refresh_secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
CLIENT_ORIGIN=http://localhost:8080

# --- OAuth2 (laisser vide si non configuré) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- Client web (service web) ---
WEB_PORT=8080
# Pour `npm run dev` en local (hors Docker). En Docker, le proxy Nginx /api est utilisé.
VITE_API_URL=http://localhost:4000/api/v1
